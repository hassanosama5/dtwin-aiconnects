# AI Configuration
# Routed through the course's LiteLLM proxy (https://litellm.i-hq.tech) --
# this must be a LiteLLM team key from litellm-api-keys.xlsx, NOT a native
# Anthropic API key. Same variable name as before the migration.
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_litellm_team_key_here

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Environment
EXPO_PUBLIC_ENV=development
