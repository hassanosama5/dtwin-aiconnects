# iHQ LiteLLM Proxy Configuration (OpenAI-compatible endpoint in front of Claude)
EXPO_PUBLIC_LITELLM_API_KEY=your_litellm_key_here
# Optional override — defaults to https://litellm.i-hq.tech/v1
# EXPO_PUBLIC_LITELLM_BASE_URL=https://litellm.i-hq.tech/v1

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Environment
EXPO_PUBLIC_ENV=development
